# 本机 G1 / MID360 配置；调用前 export 的同名变量优先。
export G1_ROS_DISTRO="${G1_ROS_DISTRO:-humble}"
export G1_NETWORK_INTERFACE="${G1_NETWORK_INTERFACE:-enp4s0}"
export G1_HOST_IP="${G1_HOST_IP:-192.168.123.99}"
export G1_LIDAR_IP="${G1_LIDAR_IP:-192.168.123.120}"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}"
export G1_ENABLE_RVIZ="${G1_ENABLE_RVIZ:-1}"
